###############################################################################
# whale-agent configuration
#
# Copy to `.env` and fill in what you have. NOTHING here is required to run: with
# an empty file the agent still ingests SEC EDGAR, Taiwan TWSE and Dataroma, ranks
# what clears the $5M gate, and prints the digest. Every key you add turns on one
# more source or channel.
#
# Setup walkthrough (free Gemini key, Gmail App Password, buying FMP/Quiver later):
#   README.md
#
# Never commit `.env` — it is gitignored.
###############################################################################

# --- Core --------------------------------------------------------------------
# SEC requires a real contact string in the User-Agent.
WHALE_SEC_USER_AGENT="Your Name you@example.com"
WHALE_DB_PATH=whale.db
WHALE_THRESHOLD_USD=5000000
WHALE_NEAR_THRESHOLD_USD=4500000
WHALE_INSTANT_USD=100000000          # Tier-1 instant-alert size

# --- LLM prose layer (optional; free tier available) --------------------------
# "gemini" (free tier, the default), "anthropic", or "none".
WHALE_LLM_PROVIDER=gemini
GEMINI_API_KEY=                      # https://aistudio.google.com/apikey  (free)
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=                   # only if WHALE_LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-5        # pin explicitly; never default to "latest"
# Cheaper for this workload: claude-sonnet-5 or claude-haiku-4-5 (see docs/SETUP.md)
OPENAI_API_KEY=                      # only if WHALE_LLM_PROVIDER=openai; optional for localhost
OPENAI_BASE_URL=https://api.openai.com/v1  # OpenRouter: https://openrouter.ai/api/v1, Ollama: http://localhost:11434/v1
OPENAI_MODEL=gpt-5.6-luna            # pin explicitly; for OpenRouter/Ollama use that server's model id
WHALE_LLM_TEMPERATURE=0.2

# --- Email delivery -----------------------------------------------------------
# "smtp" (Gmail App Password, works today) or "resend" (needs a verified domain).
WHALE_EMAIL_PROVIDER=smtp
WHALE_EMAIL_TO=you@example.com
WHALE_EMAIL_FROM=                   # defaults to SMTP_USERNAME when blank
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=                       # your full Gmail address
SMTP_PASSWORD=                       # 16-char App Password, NOT your login password
RESEND_API_KEY=

# --- Instant-alert channels (optional) ----------------------------------------
TELEGRAM_BOT_TOKEN=                  # from @BotFather
TELEGRAM_CHAT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
SLACK_WEBHOOK_URL=

###############################################################################
# DATA SOURCES
#
# Each source runs only if it is enabled AND holds the credential it needs.
# Leaving a key blank switches that source off cleanly: it is named in the
# digest's coverage note, and nothing crashes.
###############################################################################

# --- Paid vendors: leave blank until you buy them ------------------------------
# FMP (Financial Modeling Prep). Also the price provider — without it, filings that
# report share counts or percentages rather than dollars cannot be valued.
FMP_API_KEY=
WHALE_ENABLE_FMP=1                   # set 0 to force off even with a key present

# Quiver Quantitative. Congressional trades, lobbying, government contracts.
QUIVER_QUANT_API_KEY=
WHALE_ENABLE_QUIVER=1

# --- Free sources --------------------------------------------------------------
# Taiwan TWSE OpenAPI: keyless, on by default.
WHALE_ENABLE_TAIWAN=1
TAIWAN_MOPS_USER_AGENT="Your Name you@example.com"

# Japan EDINET: free API, but requires a free registered subscription key.
JAPAN_EDINET_API_KEY=
WHALE_ENABLE_JAPAN=1

# Dataroma: free public HTML, no key. Scraped — personal use only; read the module
# docstring in src/whale_agent/ingestion/dataroma.py before relying on it.
WHALE_ENABLE_DATAROMA=1

# Crypto: both have free tiers, both still issue a key.
ARKHAM_API_KEY=
WHALE_ENABLE_ARKHAM=1
WHALE_ALERT_API_KEY=
WHALE_ENABLE_WHALE_ALERT=1
WHALE_ALERT_MIN_USD=5000000

# --- WA-13 paid vendors: OFF by default, even with a key present ---------------
# Finnhub insider transactions (GET /api/v1/stock/insider-transactions).
# Uses WHALE_WATCH_TICKERS; blank = latest transactions.
FINNHUB_API_KEY=
WHALE_ENABLE_FINNHUB=0
# Unusual Whales congressional trades (GET /api/congress/recent-trades).
UNUSUAL_WHALES_API_KEY=
WHALE_ENABLE_UNUSUAL_WHALES=0

# Narrow a run to specific sources (blank = every configured source). Names come
# from `./whale digest --show-config`.
WHALE_SOURCES=

# --- Filters -------------------------------------------------------------------
# The env-var form of what a profile's [filters] table expresses. Most people should
# use `./whale digest --profile <name>` instead and keep these blank; these exist for
# deployments that can only set environment variables. Blank means "do not filter on
# this axis" -- never "filter everything out".
#
# Precedence, lowest to highest: built-in defaults, profile file, these variables,
# then CLI flags. `--show-config` prints which layer set each effective value.
WHALE_FILTER_JURISDICTIONS=          # e.g. US,TW,JP
WHALE_FILTER_EVENT_TYPES=            # e.g. open_market_buy,activist_13d
WHALE_FILTER_FILER_ROLES=            # e.g. officer,director
WHALE_FILTER_EXCLUDE_ROLES=          # e.g. 10% owner

# --- Monitoring ----------------------------------------------------------------
OPERATOR_ALERT_EMAIL=                # watchdog alerts; defaults to WHALE_EMAIL_TO
DIGEST_DEADLINE_HOUR_UTC=13          # dead-man's-switch trigger hour

# --- HTTP behaviour ------------------------------------------------------------
WHALE_HTTP_TIMEOUT=20
WHALE_HTTP_MAX_RETRIES=3
WHALE_HTTP_BACKOFF=1

# --- Storage / hosting (later phases) ------------------------------------------
DATABASE_URL=                        # Postgres DSN; falls back to WHALE_DB_PATH

# --- US government primary sources (free, keyless) -----------------------------
# USASpending.gov federal contract awards. Public domain, no key, no quota.
WHALE_ENABLE_USASPENDING=1
USASPENDING_BASE_URL=https://api.usaspending.gov

# Senate LDA lobbying disclosures. Public domain, no key. Host must stay
# lda.senate.gov — the newer lda.gov returns 403 to programmatic clients. There is
# no published rate limit, so the adapter sleeps between pages.
WHALE_ENABLE_SENATE_LDA=1
SENATE_LDA_BASE_URL=https://lda.senate.gov/api/v1
SENATE_LDA_PAGE_DELAY=1

# Treasury Fiscal Data average interest rates. Public domain, no key.
WHALE_ENABLE_TREASURY=1
TREASURY_BASE_URL=https://api.fiscaldata.treasury.gov/services/api/fiscal_service

# FRED (St. Louis Fed). Free key, request one at
# https://fredaccount.stlouisfed.org/apikeys — stays off entirely until it is set.
FRED_API_KEY=
WHALE_ENABLE_FRED=1
FRED_BASE_URL=https://api.stlouisfed.org/fred

# -- what you get (set by `whale settings`) --
WHALE_CADENCE=both                   # daily | weekly | both
WHALE_WATCH_FILERS=                  # comma-separated names or ids; blank = everyone
WHALE_WATCH_TICKERS=                 # comma-separated tickers; blank = every ticker

# -- email design (set by `whale settings` > Email design; preview: `whale preview-email`) --
WHALE_THEME=whale                    # whale | minimal | dark | newspaper
WHALE_THEME_ACCENT=                  # hex colour like #4a6f93; blank = the theme's own
WHALE_BRAND_NAME=                    # name at the top of the email; blank = Whale Digest
WHALE_EMAIL_LENGTH=detailed          # short | detailed
WHALE_EMAIL_SECTIONS=                # masthead,headline,coverage,events,footer; blank = all
